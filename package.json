{
  "name": "codewithshayy",
  "version": "2.1.0",
  "author": "Shayy <aungminkhant.shay@gmail.com>",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "postinstall": "node scripts/generate-posts-manifest.mjs",
    "dev": "node scripts/generate-posts-manifest.mjs && next dev",
    "build": "./scripts/check-public.sh && node scripts/generate-posts-manifest.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node scripts/generate-posts-manifest.mjs && tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply codewithshayy --local",
    "db:backup": "./scripts/backup.sh",
    "db:migrate:remote": "./scripts/backup.sh && wrangler d1 migrations apply codewithshayy --remote",
    "db:seed": "node scripts/build-seed.mjs > seeds/seed.sql && wrangler d1 execute codewithshayy --local --file seeds/seed.sql",
    "db:studio": "drizzle-kit studio",
    "posts:manifest": "node scripts/generate-posts-manifest.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.2",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.1",
    "jose": "^6.2.10",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.7",
    "eslint-config-next": "16.3.2",
    "gray-matter": "4.0.3",
    "postcss": "^8.5.26",
    "rehype-pretty-code": "0.14.5",
    "remark-frontmatter": "5.0.0",
    "remark-mdx-frontmatter": "5.2.0",
    "shiki": "4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
